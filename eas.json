{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "_comment": "A dev build loads its JS from Metro, so the URL that actually applies at runtime is EXPO_PUBLIC_API_URL in mobile/.env — this value is only the build-time fallback. It must still not say localhost: on a phone that means the phone itself, not the dev machine. Both need the dev machine's LAN IP, which changes with the network.",
        "EXPO_PUBLIC_API_URL": "http://192.168.29.77:3000/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.mvcleaningservices.in/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.mvcleaningservices.in/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
